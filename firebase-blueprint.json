        "password": {
          "type": "string",
          "maxLength": 128
        },
        "keterangan": {
          "type": "string",
          "maxLength": 200
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "allowedEmails": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "namaUser",
        "role",
        "password",
        "keterangan",
        "ownerUid",
        "allowedEmails",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminAccount": {
      "title": "AdminAccount",
