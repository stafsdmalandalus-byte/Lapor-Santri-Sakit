  "firestore": {
    "/master_santri/{santriDocId}": {
      "schema": { "$ref": "#/entities/MasterSantri" },
      "description": "Data induk santri Pesantren Al-Andalus."
    },
    "/users_role/{userDocId}": {
      "schema": { "$ref": "#/entities/UserRoleCredential" },
      "description": "Akun pengguna portal (hanya dapat dibaca/dikelola Admin)."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminAccount" },
      "description": "Daftar UID admin resmi Firebase."
    },
    "/staff_access/{emailKey}": {
      "schema": { "$ref": "#/entities/StaffAccess" },
      "description": "Daftar email Google staf/musyrif yang diizinkan mengakses portal."
    },
    "/laporan_musyrif/{laporanId}": {
      "schema": { "$ref": "#/entities/LaporanMusyrif" },
      "description": "Laporan santri sakit dari musyrif."
    },
    "/data_ukp/{ukpDocId}": {
      "schema": { "$ref": "#/entities/DataUKP" },
      "description": "Catatan pemeriksaan dari Unit Kesehatan Pesantren (UKP)."
    },
    "/perizinan_pulang/{perizinanId}": {
      "schema": { "$ref": "#/entities/PerizinanPulang" },
      "description": "Surat perizinan pulang santri dan status kepulangan."
    },
    "/sholat_records/{sholatId}": {
      "schema": { "$ref": "#/entities/SholatRecord" },
      "description": "Rekap harian keterlambatan sholat 5 waktu santri."
    }
  }
}
