{
  "entities": {
    "MasterSantri": {
      "title": "MasterSantri",
      "description": "Master data santri Pesantren Al-Andalus (NIS, nama, kelas, kamar, pengasuh).",
      "type": "object",
      "properties": {
        "idSantri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "namaSantri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "kelas": {
          "type": "string",
          "maxLength": 40
        },
        "kamar": {
          "type": "string",
          "maxLength": 120
        },
        "gedung": {
          "type": "string",
          "maxLength": 120
        },
        "pengasuh1": {
          "type": "string",
          "maxLength": 120
        },
        "pengasuh2": {
          "type": "string",
          "maxLength": 120
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "allowedEmails": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "idSantri",
        "namaSantri",
        "kelas",
        "kamar",
        "ownerUid",
        "allowedEmails",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserRoleCredential": {
      "title": "UserRoleCredential",
      "description": "Data akun login internal musyrif dan admin (termasuk password, khusus Admin).",
      "type": "object",
      "properties": {
        "namaUser": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["admin_pusat", "admin_pengasuhan", "admin", "user"],
          "maxLength": 32
